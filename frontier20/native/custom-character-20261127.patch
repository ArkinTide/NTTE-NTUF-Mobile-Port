+function scrNTTEFullCustomCharacterStart(_race) {
+    assert(scr_race_is_unlocked(_race),"Expected character access: "+string(_race));
+    var _icon=noone;
+    with(CharSelect) if(race==_race) _icon=id;
+    assert(instance_exists(_icon),"Real character menu omitted an available character: "+string(_race));
+    my_player.race=Race.Fish;
+    with(_icon) event_perform(ev_draw,0);
+    assert(_icon.can,"Real CharSelect Draw rejected an available character: "+string(_race));
+    with(_icon) event_perform(ev_mouse,ev_left_press);
+    assert(my_player.race==_race,"Real CharSelect click failed to select character: "+string(_race));
+
+    // This is the Player creation stage used by scrRunStart, before the first room restart.
+    scrCreatePlayers();
+    var _body=instance_find(Player,0);
+    assert(instance_number(Player)==1 && _body.race==_race && my_player.race==_race,
+        "New-run character did not survive Player creation: "+string(_race));
+    assert(_body.wep==scrRaceGetStarterWeapon(_race),"Character lost its default weapon: "+string(_race));
+    if(_race==19) {
+        assert(_body.fr_native_race==19 && _body.bubbles_bubbleCharge==_body.bubbles_maxBubbleCharge,
+            "Bubbles did not initialize its source race ability");
+    } else if(_race==Race.Skeleton) {
+        assert(_body.hp==4 && _body.max_hp==4,"Skeleton did not initialize its native health");
+    } else if(_race==Race.Frog) {
+        assert(!_body.cantoxic,"Frog did not initialize its native poison immunity");
+    }
+    instance_destroy(_body,false);
+}
